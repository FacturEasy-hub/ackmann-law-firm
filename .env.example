# Canonical production URL — used for metadata, hreflang, OG images.
# Leave unset in development; the site falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://www.ackmannlaw.com

# Optional analytics (SPEC.md Section 31). Leave empty to disable.
NEXT_PUBLIC_GA_ID=

# Contact form email delivery provider (SPEC.md Section 18/28) — provider TBD.
# CONTACT_FORM_PROVIDER_API_KEY=

# Chat widget (components/chat/ChatWidget.tsx) — free-tier LLM providers.
# OpenRouter tried first (one key, many free `:free` models), Groq as
# fallback when OpenRouter's shared 50 req/day free quota is exhausted.
# Leave both empty to keep the widget in its "not configured yet" state.
# Get keys: https://openrouter.ai/keys and https://console.groq.com/keys
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
